# Copy this file to .env and adjust for your machine.
# .env is git-ignored - never commit real values.

# Grace window (seconds) after a scheduled check-in before it counts as missed.
GRACE_SECONDS=20

# MCP server (port 8000)
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_URL=http://127.0.0.1:8000/mcp

# FastAPI web app (port 8001)
APP_HOST=127.0.0.1
APP_PORT=8001

# SQLite database file (relative to the project root)
CHECKIN_DB=checkin.db

# How often (seconds) the MCP server's monitor scans for missed check-ins.
MONITOR_INTERVAL_SECONDS=5

# Optional AI mode (Part 10). Leave the key empty to use the built-in rules.
# AI mode switches on automatically when a key is present.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: route AI mode through Amazon Bedrock instead of the Anthropic API.
# Install with: python -m pip install "anthropic[bedrock]"
# USE_BEDROCK=0
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=
