# Copy this file to .env and adjust for your machine.
# .env is git-ignored - never commit real values.

# Grace window (seconds) after a scheduled check-in before it counts as missed.
GRACE_SECONDS=20

# MCP server (port 8000)
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_URL=http://127.0.0.1:8000/mcp

# FastAPI web app (port 8001)
APP_HOST=127.0.0.1
APP_PORT=8001

# SQLite database file (relative to the project root)
CHECKIN_DB=checkin.db

# How often (seconds) the web app scans for missed check-ins.
MONITOR_INTERVAL_SECONDS=5
